{
    "manifest_version": 3,
    "name": "IdaReply",
    "version": "1.0",
    "description": "Way to add responses to Textboxes for easy replies.",
    "browser_specific_settings": {
        "gecko": {
            "id": "colender.m@gmail.com",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            },
            "update_url": "https://secretleafsociety.com/api/firefox/idareply/updates"
        }
    },
    "icons": {
        "48": "icons/icon-48.png"
    },

    "background":{"scripts":["background.js"]},
    "permissions": ["menus","scripting","activeTab"],
    "content_scripts": [{
        "matches": ["<all_urls>"],
        "js": ["idareply.js"],
        "all_frames" : true
    }
    ]

}