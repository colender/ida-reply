{
    "manifest_version": 3,
    "name": "IdaReply",
    "version": "1.0",
    "description": "Way to add responses to Textboxes for easy replies.",
    "browser_specific_settings": {
        "gecko": {
            "id": "colender.m@gmail.com",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            },
            "update_url": "https://secretleafsociety.com/api/firefox/idareply/updates"
        }
    },
    "icons": {
        "48": "icons/ida-reply-48.png"
    },

    "action":{
        "default_icon" : {
            "16": "buttons/ida-reply-16.png",
            "38": "buttons/ida-reply-38.png",
            "48": "buttons/ida-reply-48.png"
        },
        "default_title": "Ida Reply",
        "default_popup": "popup/popup.html"
    },
    

    "background":{"scripts":["background.js"]},
    "permissions": ["menus","scripting","activeTab","storage"],
    "content_scripts": [{
        "matches": ["<all_urls>"],
        "js": ["idareply.js"],
        "all_frames" : true
    }
    ]

}